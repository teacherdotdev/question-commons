{
  "name": "@teacherdotdev/question-commons",
  "version": "0.1.0",
  "description": "Reads question files written for other tools into one unified Question Bank form.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teacherdotdev/question-commons.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema/question-bank-1.0.0.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target browser --format esm --external jszip && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://questioncommons.com",
  "keywords": [
    "qti",
    "moodle",
    "gift",
    "aiken",
    "blackboard",
    "canvas",
    "kahoot",
    "blooket",
    "quizlet",
    "question bank",
    "quiz",
    "education"
  ]
}
